# Options
plugins=(git copypath copyfile copybuffer tmux vi-mode)
COMPLETION_WAITING_DOTS="%F{yellow}waiting...%f"

# Source plugins and omz
export PATH="$HOME/bin:$PATH"
export ZSH="$HOME/.oh-my-zsh"
export ZSH_TMUX_AUTOSTART=true
export ZSH_TMUX_AUTOCONNECT=true
source $ZSH/oh-my-zsh.sh

# Set faster key repeat and check for x11/wayland
if [[ "$XDG_SESSION_TYPE" == "x11" ]]; then
	xset r rate 200 40
fi

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# Vi mode options
VI_MODE_RESET_PROMPT_ON_MODE_CHANGE=true
VI_MODE_SET_CURSOR=true
VI_MODE_CURSOR_INSERT=5

# Aliases
alias gst="git status --short"
alias gl="git log -5"

# Cd into last opened directory of yazi on close
function y() {
	local tmp cwd; tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
	command rm -f -- "$tmp"
}

# Zoxide setup
eval "$(zoxide init zsh)"

# Initialize custom oh-my-posh theme
eval "$(oh-my-posh init zsh --config $HOME/dotfiles/zsh/themes/cattpuccin.toml)"
